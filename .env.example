# Web app (public, compiled into the browser bundle)
NEXT_PUBLIC_GAME_SERVER_URL=http://localhost:4000
# Game server
PORT=4000
CLIENT_ORIGIN=http://localhost:3000
# Optional: persistent completed-match history
DATABASE_URL=
